# Optional persistent disk mount. Default: <repository>/sandbox
# FLEET_STATE_ROOT=/var/data/fleet-console

# Agent loop (OpenAI Chat Completions). The key stays on the server; never sent to the browser.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# FLEET_AGENT_MODEL=gpt-4.1-mini
# USD per 1M tokens: input,cached input,output (default: gpt-4.1-mini list price)
# FLEET_PRICE_USD_PER_M=0.40,0.10,1.60
FLEET_DAILY_RUNS=20
FLEET_MAX_RUN_USD=0.25
# A start or a resume consumes one daily slot (UTC); reset cannot refund it.
